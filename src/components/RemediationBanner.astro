---
import { siteData } from '../data/siteData';
---

<section class="py-12 md:py-14 bg-white border-y border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-amber-50/80 via-[#fffcf9] to-amber-50/40 border-0 border-l-[6px] border-l-amber-600 shadow-[0_12px_40px_-8px_rgba(217,119,6,0.12)] flex flex-col lg:flex-row lg:items-center justify-between gap-8 relative overflow-hidden">
      
      <!-- Subtle Ambient Urgency Radial Highlight -->
      <div 
        class="absolute -left-12 top-1/2 -translate-y-1/2 w-72 h-72 rounded-full pointer-events-none opacity-40 -z-0"
        style="background: radial-gradient(circle, rgba(217, 119, 6, 0.22) 0%, transparent 70%); filter: blur(30px);"
      ></div>

      <!-- Left side copy -->
      <div class="max-w-3xl space-y-2.5 relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100/90 border-0 text-xs font-sans font-bold uppercase tracking-wider text-amber-950 shadow-2xs">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-600"></span>
          </span>
          <svg class="w-3.5 h-3.5 text-amber-800 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>{siteData.remediationCallout.badge}</span>
        </div>

        <h3 
          class="text-2xl sm:text-3xl lg:text-4xl font-serif italic instrument-italic premium-italic text-slate-950 tracking-tight"
          style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
        >
          {siteData.remediationCallout.title}
        </h3>

        <p class="text-base sm:text-lg text-slate-800 leading-relaxed font-sans">
          {siteData.remediationCallout.description}
        </p>
      </div>

      <!-- Right side actions -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 shrink-0 relative z-10">
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl bg-[#991b1b] hover:bg-[#7f1d1d] text-white font-bold text-sm tracking-wide shadow-md shadow-red-950/15 border-0 transition-all hover:-translate-y-0.5 whitespace-nowrap"
        >
          <span>{siteData.remediationCallout.actionText}</span>
          <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href={`tel:${siteData.contact.phone}`}
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white/95 hover:bg-white text-amber-950 text-sm font-sans font-bold transition-colors shadow-2xs border-0 whitespace-nowrap"
        >
          <svg class="w-4 h-4 text-amber-700 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Direct Advisory Line</span>
        </a>
      </div>

    </div>
  </div>
</section>
