---
import { siteData } from '../data/siteData';
---

<!-- High-Transparency Crystalline Glassmorphism Header -->
<header 
  class="sticky top-0 z-50 w-full transition-all duration-300"
  style="background: linear-gradient(180deg, rgba(255, 255, 255, 0.42) 0%, rgba(255, 255, 255, 0.22) 100%); -webkit-backdrop-filter: blur(28px) saturate(210%); backdrop-filter: blur(28px) saturate(210%); border-bottom: 1px solid rgba(255, 255, 255, 0.50); box-shadow: 0 10px 35px 0 rgba(10, 43, 78, 0.05), inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.90);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Navbar Layout: Center-Aligned across viewport with generous sizing -->
    <div class="flex items-center justify-between md:justify-center md:gap-8 lg:gap-12 h-20 sm:h-22">
      
      <!-- Left / Brand Logo with Name -->
      <a href="#" class="flex items-center gap-3 shrink-0 group transition-transform hover:scale-[1.02]">
        <img 
          src="/steriqual-logo.svg" 
          alt={`${siteData.company.name} - Quality & Sterility Consulting`} 
          class="h-10 sm:h-12 w-auto object-contain"
        />
      </a>

      <!-- Center: Navigation Links with Soft Glass Hover Treatments -->
      <nav class="hidden md:flex items-center justify-center gap-3 lg:gap-5">
        <a href="#services" class="text-[15px] lg:text-base font-semibold text-slate-800 hover:text-[#18a692] px-3.5 py-1.5 rounded-xl hover:bg-white/60 hover:shadow-2xs transition-all whitespace-nowrap">Services</a>
        <a href="#models" class="text-[15px] lg:text-base font-semibold text-slate-800 hover:text-[#18a692] px-3.5 py-1.5 rounded-xl hover:bg-white/60 hover:shadow-2xs transition-all whitespace-nowrap">Engagement</a>
        <a href="#founder" class="text-[15px] lg:text-base font-semibold text-slate-800 hover:text-[#18a692] px-3.5 py-1.5 rounded-xl hover:bg-white/60 hover:shadow-2xs transition-all whitespace-nowrap">Founder</a>
        <a href="#contact" class="text-[15px] lg:text-base font-semibold text-slate-800 hover:text-[#18a692] px-3.5 py-1.5 rounded-xl hover:bg-white/60 hover:shadow-2xs transition-all whitespace-nowrap">Contact</a>
      </nav>

      <!-- Right: Action CTA Button in Brand Navy with Teal Glow -->
      <div class="hidden sm:flex items-center shrink-0">
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-6 py-2.5 text-sm font-bold text-white bg-[#0a2b4e] hover:bg-[#18a692] rounded-xl transition-all shadow-md shadow-[#0a2b4e]/20 hover:shadow-[#18a692]/30 hover:-translate-y-0.5 whitespace-nowrap"
        >
          Book Consultation
        </a>
      </div>

      <!-- Mobile Menu Toggle Button with Frosted Glass Styling -->
      <div class="flex md:hidden items-center gap-2 shrink-0">
        <a
          href="#contact"
          class="px-3.5 py-1.5 text-xs font-semibold text-white bg-[#0a2b4e] hover:bg-[#18a692] rounded-lg transition-colors whitespace-nowrap sm:hidden"
        >
          Consult
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle Navigation Menu"
          class="p-2 rounded-xl text-slate-700 hover:text-[#0a2b4e] border border-white/60 shadow-xs transition-all"
          style="background: rgba(255, 255, 255, 0.40); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu (High-Transparency Glass) -->
    <div 
      id="mobile-menu" 
      class="hidden md:hidden border-t border-white/40 py-5 px-3 space-y-2 text-center rounded-b-3xl mt-1 shadow-lg"
      style="background: linear-gradient(180deg, rgba(255, 255, 255, 0.75) 0%, rgba(255, 255, 255, 0.45) 100%); -webkit-backdrop-filter: blur(28px) saturate(200%); backdrop-filter: blur(28px) saturate(200%);"
    >
      <a href="#services" class="mobile-link block px-4 py-2.5 rounded-lg text-lg font-semibold text-slate-800 hover:text-[#18a692] hover:bg-white/50 whitespace-nowrap">Services</a>
      <a href="#models" class="mobile-link block px-4 py-2.5 rounded-lg text-lg font-semibold text-slate-800 hover:text-[#18a692] hover:bg-white/50 whitespace-nowrap">Engagement</a>
      <a href="#founder" class="mobile-link block px-4 py-2.5 rounded-lg text-lg font-semibold text-slate-800 hover:text-[#18a692] hover:bg-white/50 whitespace-nowrap">Founder</a>
      <a href="#contact" class="mobile-link block px-4 py-2.5 rounded-lg text-lg font-semibold text-slate-800 hover:text-[#18a692] hover:bg-white/50 whitespace-nowrap">Contact</a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  const links = document.querySelectorAll('.mobile-link');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden', !isExpanded);
    closeIcon?.classList.toggle('hidden', isExpanded);
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
