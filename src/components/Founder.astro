---
import { siteData } from '../data/siteData';

const consultingExpertise = [
  "Quality Management System (QMS) design, assessment, and remediation",
  "Regulatory inspection readiness and mock audits",
  "Data Integrity and GMP compliance programs",
  "Sterile manufacturing and aseptic process assurance",
  "Site quality leadership and quality transformation initiatives",
  "Investigation management (Deviation, OOS, OOT, CAPA)",
  "Qualification and validation programs",
  "Technology transfer and product commercialization support",
  "Greenfield and brownfield facility quality system implementation",
  "Regulatory response strategy and audit remediation",
  "Operational excellence and quality performance improvement",
  "Training, coaching, and leadership development for quality organizations",
];

const dosageForms = [
  "Injectables",
  "Lyophilized Products",
  "Ophthalmics",
  "Prefilled Syringes (PFS)",
  "Oral Solids",
  "Oncology Products",
  "Hormones",
  "Nasal Dosage Forms",
];

const leadingOrganizations = [
  "Sun Pharmaceutical Industries",
  "Emcure Pharmaceuticals",
  "Intas Pharmaceuticals",
  "LIVA Pharmaceuticals (Now Zydus)",
  "Alembic Pharmaceuticals",
  "Innoxel Lifesciences",
];
---

<section id="founder" class="py-14 md:py-16 bg-slate-50/70 border-t border-slate-100 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Header with Editorial Styling -->
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-2">
      <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-[#18a692] font-bold">
        Executive Profile
      </span>
      <h2 
        class="text-3xl sm:text-4xl lg:text-5xl font-serif italic instrument-italic premium-italic text-[#0a2b4e] tracking-tight"
        style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
      >
        Principal Consultant Leadership
      </h2>
      <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-sans">
        SteriQual client engagements are led directly by Pinkal Dave—bringing nearly three decades of executive quality, compliance, and sterile manufacturing leadership from premier global pharmaceutical enterprises.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Founder Visual & Credential Dossier: Border-less Gradient Card (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="relative rounded-3xl p-6 sm:p-8 bg-gradient-to-b from-white via-[#fbfdfd] to-[#edf7f5]/40 border-0 shadow-[0_12px_40px_-10px_rgba(10,43,78,0.06)]">
          
          <!-- Avatar Placeholder / Portrait Frame -->
          <div class="relative mx-auto w-44 h-44 sm:w-52 sm:h-52 rounded-2xl bg-slate-100 p-1 mb-6 border-0 shadow-inner">
            <div class="w-full h-full rounded-2xl bg-slate-50 flex flex-col items-center justify-center text-slate-400 overflow-hidden relative">
              <svg class="w-20 h-20 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 2.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
              </svg>
              <span class="text-xs font-sans text-slate-400 mt-2 font-medium">[Executive Portrait]</span>
            </div>
            <!-- Experience badge on avatar in Deep Blue -->
            <div class="absolute -bottom-3 -right-3 bg-[#0a2b4e] text-white px-4 py-1.5 rounded-full text-xs sm:text-sm font-sans font-bold shadow-md border-2 border-white flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#18a692]"></span>
              <span>Nearly 3 Decades Experience</span>
            </div>
          </div>

          <!-- Name & Official Designation -->
          <div class="text-center space-y-1.5">
            <h3 class="text-2xl sm:text-3xl font-bold text-[#0a2b4e] tracking-tight">{siteData.founder.fullName}</h3>
            <p class="text-base sm:text-lg font-semibold text-[#18a692] font-sans leading-snug">
              Founder and Principal Consultant – Quality, Compliance &amp; Sterile Operations
            </p>
            <p class="text-xs sm:text-sm font-sans text-slate-600 font-medium">{siteData.founder.designationHistory}</p>
            <p class="text-xs text-slate-500 font-sans pt-0.5">{siteData.founder.location}</p>
          </div>

          <!-- Direct Engagement Commitment: Soft Borderless Gradient -->
          <div class="mt-6 pt-4 border-t border-slate-100 bg-gradient-to-br from-[#f0faf8] to-[#e4f3f0] -mx-4 -mb-4 p-5 rounded-b-2xl border-0">
            <div class="text-xs sm:text-sm font-sans text-[#0a2b4e] font-bold flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#18a692]"></span>
              <span>Direct Principal-Led Oversight</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-700 mt-1.5 leading-relaxed font-sans">
              All advisory scopes, mock audits, and documentation reviews are conducted personally by Pinkal Dave—never delegated to junior associates.
            </p>
          </div>

        </div>

        <!-- Quick Consultation Action Card -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-[#f0faf8] via-white to-[#e8f5f2] border-0 shadow-[0_8px_30px_-6px_rgba(10,43,78,0.05)] space-y-3.5">
          <div class="text-xs font-sans font-bold text-[#0a2b4e] uppercase tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#18a692]"></span>
            <span>Direct Technical Advisory</span>
          </div>
          <p class="text-sm text-slate-700 leading-relaxed font-sans">
            Connect directly with Pinkal Dave for confidential technical discussions, regulatory inspection defense, or QMS strengthening.
          </p>
          <div class="pt-1 flex flex-col gap-2.5">
            <a
              href="#contact"
              class="w-full inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-[#0a2b4e] hover:bg-[#18a692] rounded-xl shadow-md shadow-[#0a2b4e]/20 transition-all text-center"
            >
              Schedule Consultation with Mr. Dave
            </a>
            <a
              href={`mailto:${siteData.contact.email}`}
              class="w-full inline-flex items-center justify-center px-6 py-2.5 text-xs font-semibold text-[#0a2b4e] bg-white hover:bg-slate-50 rounded-xl border border-slate-200 transition-colors shadow-2xs text-center"
            >
              Direct Email: {siteData.contact.email}
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Full Executive Narrative & Scope (7 cols) -->
      <div class="lg:col-span-7 space-y-8">
        
        <!-- Executive Narrative Block -->
        <div class="space-y-4">
          <h3 
            class="text-2xl sm:text-3xl lg:text-4xl font-serif italic instrument-italic premium-italic text-[#0a2b4e] tracking-tight leading-tight"
            style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
          >
            Nearly Three Decades of Executive Quality &amp; Sterile Operations Leadership
          </h3>

          <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-sans">
            <strong>Pinkal Dave</strong> is a seasoned pharmaceutical quality and compliance leader with nearly three decades of experience across globally regulated pharmaceutical manufacturing environments. Throughout his distinguished career, he has held senior leadership positions with leading pharmaceutical organizations including <strong>Sun Pharmaceutical Industries, Emcure Pharmaceuticals, Intas Pharmaceuticals, LIVA Pharmaceuticals (Now Zydus), Alembic Pharmaceuticals,</strong> and <strong>Innoxel Lifesciences</strong>.
          </p>

          <!-- Leading Organizations Chip Strip -->
          <div class="pt-1">
            <span class="text-xs font-sans uppercase tracking-wider text-slate-500 font-bold block mb-2">
              Career Leadership Tenures Across Top Pharmaceutical Enterprises
            </span>
            <div class="flex flex-wrap gap-2">
              {leadingOrganizations.map(org => (
                <span class="text-xs sm:text-sm font-sans font-semibold text-[#0a2b4e] bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] px-3.5 py-1.5 rounded-xl border-0 shadow-2xs">
                  {org}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Functional Scope & Dosage Specialization -->
        <div class="p-6 sm:p-7 rounded-3xl bg-gradient-to-br from-white via-[#fbfdfd] to-[#edf7f5]/50 border-0 shadow-[0_8px_30px_-6px_rgba(10,43,78,0.05)] space-y-4">
          <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-[#18a692] font-bold block">
            Executive Functional Command &amp; Dosage Expertise
          </span>

          <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans">
            As a quality executive, he has successfully led <strong>Quality Assurance, Quality Control, Compliance, Validation, Microbiology,</strong> and <strong>Regulatory affairs</strong> functions for large-scale sterile and oral manufacturing facilities serving highly regulated international markets.
          </p>

          <div>
            <span class="text-xs font-sans uppercase tracking-wider text-slate-600 font-bold block mb-2">
              Comprehensive Product &amp; Dosage Scope
            </span>
            <div class="flex flex-wrap gap-2">
              {dosageForms.map(form => (
                <span class="text-xs sm:text-sm font-sans font-semibold text-[#0a2b4e] bg-white px-3 py-1.5 rounded-lg border border-slate-200/80 shadow-2xs">
                  {form}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- PQS, Quality Culture & Global Regulatory Defense -->
        <div class="space-y-4">
          <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-sans">
            Pinkal Dave has extensive experience in designing, implementing, and strengthening <strong>Pharmaceutical Quality Systems (PQS)</strong>, establishing quality cultures, leading remediation programs, and preparing organizations for global regulatory inspections. He has directly participated in and managed <strong>more than 30 major regulatory inspections</strong> by agencies including the <strong>US FDA, MHRA, Health Canada, TGA Australia, ANVISA Brazil, CDSCO,</strong> and various international regulatory authorities, in addition to <strong>over 100 customer and third-party audits</strong>.
          </p>

          <!-- Authority Inspection Badges -->
          <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-bold">
            <span class="px-3.5 py-1.5 rounded-xl bg-[#0a2b4e] text-white shadow-2xs">30+ Regulatory Inspections</span>
            <span class="px-3.5 py-1.5 rounded-xl bg-[#18a692] text-white shadow-2xs">100+ Customer Audits</span>
            <span class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] text-[#0a2b4e] shadow-2xs">US FDA</span>
            <span class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] text-[#0a2b4e] shadow-2xs">MHRA (UK)</span>
            <span class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] text-[#0a2b4e] shadow-2xs">Health Canada</span>
            <span class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] text-[#0a2b4e] shadow-2xs">TGA Australia</span>
            <span class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] text-[#0a2b4e] shadow-2xs">ANVISA Brazil</span>
            <span class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] text-[#0a2b4e] shadow-2xs">CDSCO</span>
          </div>
        </div>

        <!-- Core Consulting Expertise (The 12 Focus Areas) -->
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-[#f0faf8] via-[#f7fcfa] to-[#e8f5f2] border-0 shadow-[0_8px_30px_-6px_rgba(10,43,78,0.05)] space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-[#0a2b4e] font-bold flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#18a692]"></span>
              <span>Consulting Expertise &amp; Core Competencies</span>
            </span>
            <span class="text-xs font-sans font-semibold text-[#18a692] bg-white px-2.5 py-0.5 rounded-md shadow-2xs">
              12 Practice Areas
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
            {consultingExpertise.map(exp => (
              <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-white/90 shadow-2xs">
                <svg class="w-4 h-4 text-[#18a692] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs sm:text-sm font-sans font-medium text-slate-800 leading-snug">
                  {exp}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Scale of Leadership & Operational Impact Banner -->
        <div class="p-6 sm:p-7 rounded-3xl bg-gradient-to-r from-[#0a2b4e] to-[#0e3d64] text-white shadow-lg space-y-2.5">
          <div class="text-xs font-sans uppercase tracking-wider text-[#18a692] font-bold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#18a692] animate-pulse"></span>
            <span>Scale of Leadership</span>
          </div>
          <p class="text-sm sm:text-base text-slate-100 leading-relaxed font-sans">
            Over the course of his career, he has successfully led cross-functional quality teams exceeding <strong>250 professionals</strong> and has consistently delivered measurable improvements in quality performance, compliance maturity, inspection outcomes, and operational reliability.
          </p>
        </div>

        <!-- Academic & Strategic Growth Summary -->
        <div class="space-y-3 pt-1">
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans">
            He holds a <strong>Master of Science (Microbiology)</strong>, a <strong>Master's Diploma in Pharmaceutical Management (MDPM)</strong>, and an <strong>MBA in Personnel Management</strong>.
          </p>
          <p class="text-base sm:text-lg text-slate-800 leading-relaxed font-sans font-medium">
            His deep technical expertise, strong regulatory knowledge, and practical leadership experience enable him to provide strategic and operational solutions that help pharmaceutical organizations strengthen compliance, enhance quality performance, and achieve sustainable business growth.
          </p>
        </div>

        <!-- Founder Philosophy Quote Box -->
        <div class="p-6 rounded-2xl bg-gradient-to-r from-[#fbfdfd] to-[#f0faf8] border-l-4 border-l-[#18a692] border-0 text-slate-700 relative shadow-2xs">
          <p 
            class="text-sm sm:text-base font-serif italic instrument-italic premium-italic text-[#0a2b4e] leading-relaxed"
            style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
          >
            "{siteData.founder.quote}"
          </p>
          <div class="mt-2.5 text-xs sm:text-sm font-sans text-[#18a692] font-bold">
            — {siteData.founder.fullName}, {siteData.founder.title}
          </div>
        </div>

        <!-- Action Row -->
        <div class="pt-2 flex flex-wrap items-center gap-3.5">
          <a
            href="#contact"
            class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-bold text-white bg-[#0a2b4e] hover:bg-[#18a692] rounded-xl shadow-md shadow-[#0a2b4e]/20 hover:shadow-[#18a692]/25 transition-all hover:-translate-y-0.5"
          >
            Schedule Consultation with Mr. Dave
          </a>
          <a
            href={`mailto:${siteData.contact.email}`}
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold text-[#0a2b4e] bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] hover:from-[#e4f3f0] hover:to-[#d2ece6] hover:text-[#106c60] rounded-xl border-0 transition-colors shadow-2xs"
          >
            Direct Email: {siteData.contact.email}
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
