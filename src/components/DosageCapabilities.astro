---
import { siteData } from '../data/siteData';
---

<section id="scope" class="py-14 md:py-16 bg-slate-50/60 border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between mb-10 gap-4">
      <div class="max-w-2xl">
        <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-[#18a692] font-bold">
          Technical Scope
        </span>
        <h2 
          class="text-3xl sm:text-4xl lg:text-5xl font-serif italic instrument-italic premium-italic text-[#0a2b4e] mt-1"
          style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
        >
          Specialist Sterile Formulations &amp; Processes
        </h2>
        <p class="text-base sm:text-lg text-slate-700 mt-2 leading-relaxed">
          Targeted quality leadership tailored strictly to aseptic operations, advanced barrier isolation, and high-potency sterile processing.
        </p>
      </div>

      <div class="text-xs sm:text-sm font-sans font-semibold text-[#0a2b4e] bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] px-4.5 py-2 rounded-xl border-0 shadow-2xs">
        Targeting: USFDA • EU-GMP • WHO • ROW Sites
      </div>
    </div>

    <!-- Border-less Gradient Dossier Cards (No Rigid Dividing Borders) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {siteData.specialistScope.map((item, index) => (
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-b from-white via-[#fbfdfd] to-[#edf7f5]/40 border-0 shadow-[0_8px_30px_-6px_rgba(10,43,78,0.05)] hover:shadow-[0_14px_40px_-6px_rgba(24,166,146,0.12)] transition-all flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            
            <!-- Category Header Line -->
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <span class="text-xs font-sans text-slate-400 font-bold uppercase tracking-wider">
                Category 0{index + 1}
              </span>
              <span class="text-[11px] font-sans font-bold text-[#18a692] bg-[#f0faf8] px-2.5 py-0.5 rounded-md border-0">
                Active Scope
              </span>
            </div>

            <!-- Title: Consistent Reserved Height Across All Cards -->
            <div class="h-14 sm:h-16 flex items-start">
              <h3 class="text-lg sm:text-xl font-bold text-[#0a2b4e] tracking-tight leading-snug">
                {item.title}
              </h3>
            </div>

            <!-- Standard Reference Box: Borderless Soft Gradient with Uniform Height -->
            <div class="h-14 sm:h-16 flex items-center">
              <div class="w-full text-xs font-sans font-bold text-[#0a2b4e] bg-gradient-to-r from-[#f0faf8] via-[#e6f5f2] to-[#daf1ed] px-3.5 py-2.5 rounded-xl border-0 leading-snug text-center shadow-2xs">
                {item.standard}
              </div>
            </div>

            <!-- Description -->
            <div class="min-h-[5.5rem] pt-1">
              <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans">
                {item.desc}
              </p>
            </div>

          </div>

          <!-- Card Bottom Baseline -->
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs sm:text-sm font-sans text-slate-500">
            <span>Sterile QA Practice</span>
            <span class="text-[#18a692] font-bold">Verified</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
