---
import { siteData } from '../data/siteData';
---

<section class="relative overflow-hidden pt-6 pb-14 md:pt-10 md:pb-18 bg-white">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Hero Center Content -->
    <div class="max-w-5xl mx-auto text-center space-y-7 relative">
      
      <!-- Trust Tag: Executive Sans Typography with Logo Teal Accent -->
      <div class="inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-2.5 rounded-full bg-gradient-to-r from-[#f0faf8] via-[#eaf6f4] to-[#e8f1f8] border-0 text-xs sm:text-sm font-sans font-semibold tracking-wide text-[#0a2b4e] shadow-2xs max-w-full">
        <span class="w-2.5 h-2.5 rounded-full bg-[#18a692] shrink-0 animate-pulse"></span>
        <span class="whitespace-nowrap">Independent Specialist Advisory</span>
      </div>

      <!-- Main Title Container with Directly Anchored, Enlarged & Intensified Fading Oval Gradient -->
      <div class="relative py-2">
        <!-- Enlarged & Intensified Logo-Tuned Navy & Teal Dual-Tone Fading Oval Gradient Layer -->
        <div 
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] sm:w-[950px] md:w-[1300px] lg:w-[1550px] h-[320px] sm:h-[460px] md:h-[560px] lg:h-[620px] pointer-events-none rounded-[100%] -z-10"
          style="background: radial-gradient(ellipse 70% 55% at 50% 50%, rgba(10, 43, 78, 0.50) 0%, rgba(18, 135, 119, 0.35) 35%, rgba(24, 166, 146, 0.20) 60%, rgba(45, 212, 191, 0.08) 80%, transparent 100%); filter: blur(42px);"
        ></div>

        <!-- Secondary Core Aura for extra depth and brilliance -->
        <div 
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[380px] sm:w-[650px] md:w-[900px] lg:w-[1100px] h-[200px] sm:h-[300px] md:h-[380px] pointer-events-none rounded-[100%] -z-10"
          style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(24, 166, 146, 0.30) 0%, rgba(10, 43, 78, 0.25) 50%, transparent 100%); filter: blur(30px);"
        ></div>

        <!-- Main Headline in Instrument Serif Italics (Navy & Teal Palette from Logo) -->
        <h1 
          class="relative text-5xl sm:text-7xl lg:text-[90px] xl:text-[104px] font-serif italic instrument-italic premium-italic text-[#0a2b4e] leading-[1.05] tracking-tight"
          style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
        >
          Quality, Compliance <br />
          <span class="text-[#18a692]">&amp; Sterility Assurance</span>
        </h1>
      </div>

      <!-- Subheadline - Enlarged Font Size to Fill Horizontal Proportion -->
      <p class="text-xl sm:text-2xl md:text-[25px] text-slate-700 max-w-3xl mx-auto font-normal leading-relaxed">
        Independent pharmaceutical advisory for manufacturers for global regulated market.
      </p>

      <!-- Action Buttons (Brand Navy with Teal Hover Glow) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href="#contact"
          class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4.5 text-base sm:text-lg font-bold text-white bg-[#0a2b4e] hover:bg-[#128777] rounded-xl shadow-md shadow-[#0a2b4e]/25 hover:shadow-[#18a692]/30 transition-all hover:-translate-y-0.5"
        >
          <span>Schedule Technical Discussion</span>
          <svg class="ml-2.5 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="#services"
          class="w-full sm:w-auto inline-flex items-center justify-center px-9 py-4.5 text-base sm:text-lg font-bold text-[#0a2b4e] bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] hover:from-[#e4f3f0] hover:to-[#d2ece6] hover:text-[#106c60] rounded-xl transition-all hover:-translate-y-0.5 shadow-2xs"
        >
          Explore Core Services
        </a>
      </div>

    </div>

    <!-- Founder's Career Track Record Band with Border-less Gradient Cards -->
    <div class="mt-14 pt-10 border-t border-slate-100 max-w-6xl mx-auto">
      
      <div class="text-center mb-8">
        <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-[#18a692] font-bold block">
          Founder's Career Leadership Record
        </span>
        <p class="text-base text-slate-700 mt-1">
          Steered by Principal Consultant <strong>{siteData.founder.fullName}</strong> across Indian top 20 Pharma giants
        </p>
      </div>

      <!-- Metrics Grid with Border-less Gradient Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        {siteData.founderMetrics.map(metric => (
          <div class="space-y-1.5 p-6 sm:p-7 rounded-3xl bg-gradient-to-b from-[#fbfdfd] via-[#f0faf8]/70 to-[#e4f3f0]/50 border-0 shadow-[0_8px_30px_-6px_rgba(10,43,78,0.04)] hover:shadow-[0_12px_36px_-6px_rgba(24,166,146,0.12)] transition-all">
            <div class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-[#0a2b4e] tracking-tight font-sans">{metric.value}</div>
            <div class="text-base sm:text-lg font-bold text-slate-900 mt-1 font-sans">{metric.label}</div>
            <div class="text-xs sm:text-sm text-slate-600 mt-0.5 font-sans font-medium">{metric.sublabel}</div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
