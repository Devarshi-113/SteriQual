---
import { siteData } from '../data/siteData';
---

<section id="contact" class="py-14 md:py-16 bg-white relative overflow-hidden border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      
      <!-- Left Column: Contact Details & Office (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-[#18a692] font-bold">Direct Communication</span>
          <h2 
            class="text-3xl sm:text-4xl lg:text-5xl font-serif italic instrument-italic premium-italic text-[#0a2b4e] mt-1 tracking-tight"
            style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
          >
            Connect with Senior QA Leadership
          </h2>
          <p class="text-base sm:text-lg text-slate-700 mt-2.5 leading-relaxed font-sans">
            Whether you are preparing for an imminent regulatory inspection, resolving a Form 483 or Warning Letter, or strengthening sterility assurance controls, discuss your technical scope directly with Pinkal Dave.
          </p>
        </div>

        <!-- Contact Points List -->
        <div class="space-y-5 pt-1">
          
          <!-- Direct Telephone -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#f0faf8] to-[#e4f3f0] border-0 flex items-center justify-center text-[#0a2b4e] shrink-0 shadow-2xs">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-sans text-slate-500 font-medium">Direct Telephone &amp; Mobile</div>
              <a href={`tel:${siteData.contact.phone}`} class="text-base sm:text-lg font-bold text-[#0a2b4e] hover:text-[#18a692] transition-colors">
                {siteData.contact.phoneDisplay}
              </a>
              <div class="text-xs sm:text-sm text-slate-500 mt-0.5 font-sans">{siteData.contact.operatingHours}</div>
            </div>
          </div>

          <!-- Official Email -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#f0faf8] to-[#e4f3f0] border-0 flex items-center justify-center text-[#0a2b4e] shrink-0 shadow-2xs">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-sans text-slate-500 font-medium">Direct Email Contact</div>
              <a href={`mailto:${siteData.contact.email}`} class="text-base sm:text-lg font-bold text-[#0a2b4e] hover:text-[#18a692] transition-colors">
                {siteData.contact.email}
              </a>
              <div class="text-xs sm:text-sm text-slate-500 mt-0.5 font-sans">Strict confidentiality observed</div>
            </div>
          </div>

          <!-- WhatsApp Chat -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 border-0 flex items-center justify-center text-emerald-600 shrink-0 shadow-2xs">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.04 7.69C8.86 7.69 8.56 7.76 8.32 8.02C8.07 8.28 7.39 8.92 7.39 10.22C7.39 11.52 8.34 12.78 8.47 12.95C8.6 13.12 10.3 15.89 12.97 16.94C15.19 17.81 15.64 17.64 16.12 17.59C16.6 17.55 17.67 16.96 17.89 16.33C18.11 15.7 18.11 15.16 18.04 15.05C17.97 14.94 17.8 14.88 17.54 14.75C17.29 14.62 16.03 14 15.8 13.91C15.57 13.82 15.4 13.78 15.23 14.04C15.06 14.3 14.58 14.88 14.43 15.05C14.28 15.22 14.13 15.24 13.88 15.11C13.63 14.98 12.82 14.72 11.86 13.86C11.11 13.19 10.6 12.36 10.45 12.11C10.3 11.86 10.43 11.72 10.56 11.59C10.68 11.47 10.82 11.28 10.96 11.12C11.1 10.96 11.15 10.84 11.24 10.67C11.33 10.5 11.28 10.35 11.22 10.22C11.15 10.1 10.65 8.87 10.44 8.37C10.25 7.89 10.05 7.95 9.89 7.95C9.75 7.94 9.58 7.69 9.04 7.69Z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-sans text-slate-500 font-medium">Direct WhatsApp</div>
              <a
                href={`https://wa.me/${siteData.contact.whatsappNumber}?text=${encodeURIComponent(siteData.contact.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base sm:text-lg font-bold text-emerald-700 hover:text-emerald-800 transition-colors inline-flex items-center gap-1 font-sans"
              >
                <span>Click to message Mr. Dave</span>
                <span class="text-sm">↗</span>
              </a>
              <div class="text-xs sm:text-sm text-slate-500 mt-0.5 font-sans">Quick consultation &amp; scheduling</div>
            </div>
          </div>

          <!-- Location & Practice Reach -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#f0faf8] to-[#e4f3f0] border-0 flex items-center justify-center text-[#0a2b4e] shrink-0 shadow-2xs">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-xs sm:text-sm font-sans text-slate-500 font-medium">Consultancy Base</div>
              <div class="text-base sm:text-lg font-bold text-[#0a2b4e] mt-0.5 font-sans">
                {siteData.contact.location}
              </div>
              <div class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed font-sans">
                {siteData.contact.engagementReach}
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- Right Column: Interactive Inquiry Form (Border-less Gradient Card) (7 cols) -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-white via-[#fbfdfd] to-[#edf7f5]/40 border-0 shadow-[0_12px_45px_-10px_rgba(10,43,78,0.07)]">
          
          <h3 class="text-xl sm:text-2xl font-bold text-[#0a2b4e] mb-1.5">Technical Engagement Inquiry</h3>
          <p class="text-sm text-slate-600 mb-6 leading-relaxed">
            Share your project parameters. All inquiries are treated with strict confidentiality under standard non-disclosure terms.
          </p>

          <form id="consultation-form" class="space-y-4">
            <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
            <input type="hidden" name="subject" value="New Inquiry - SteriQual Pharma Consulting" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm font-semibold text-slate-800 mb-1.5">Full Name *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Dr. Amit Patel"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm sm:text-base focus:outline-none focus:border-[#18a692] focus:ring-1 focus:ring-[#18a692] transition-colors shadow-2xs"
                />
              </div>

              <div>
                <label for="company" class="block text-sm font-semibold text-slate-800 mb-1.5">Company / Facility *</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  placeholder="e.g. Acme Sterile Parenterals"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm sm:text-base focus:outline-none focus:border-[#18a692] focus:ring-1 focus:ring-[#18a692] transition-colors shadow-2xs"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-sm font-semibold text-slate-800 mb-1.5">Official Email *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="name@company.com"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm sm:text-base focus:outline-none focus:border-[#18a692] focus:ring-1 focus:ring-[#18a692] transition-colors shadow-2xs"
                />
              </div>

              <div>
                <label for="phone" class="block text-sm font-semibold text-slate-800 mb-1.5">Mobile / WhatsApp *</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="+91 98765 00000"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm sm:text-base focus:outline-none focus:border-[#18a692] focus:ring-1 focus:ring-[#18a692] transition-colors shadow-2xs"
                />
              </div>
            </div>

            <div>
              <label for="service_interest" class="block text-sm font-semibold text-slate-800 mb-1.5">Primary Advisory Scope</label>
              <select
                id="service_interest"
                name="service_interest"
                class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm sm:text-base focus:outline-none focus:border-[#18a692] focus:ring-1 focus:ring-[#18a692] transition-colors shadow-2xs"
              >
                <option value="sterility-assurance">Sterility Assurance &amp; Contamination Control Strategy (CCS / Annex 1)</option>
                <option value="inspection-readiness">Regulatory Inspection Readiness &amp; Mock Audit (USFDA / EU / TGA)</option>
                <option value="audit-remediation">Warning Letter &amp; Form 483 Remediation / CAPA Response</option>
                <option value="qms-six-systems">QMS Improvement &amp; The Six Quality Systems Compliance</option>
                <option value="micro-lab">Microbiology Laboratory Setup &amp; Method Validation</option>
                <option value="qualification-csv">Equipment Qualification &amp; Computer System Validation (CSV)</option>
                <option value="fractional-vp">Fractional VP Quality / Strategic Leadership Advisory</option>
                <option value="other">Other Sterile Quality Scope</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-slate-800 mb-1.5">Manufacturing Block / Specific Requirement</label>
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Mention dosage form (SVP / Lyo / PFS), target agency (USFDA / EU / WHO), or timeline..."
                class="w-full px-4 py-3 rounded-xl bg-white border border-slate-300 text-slate-900 placeholder-slate-400 text-sm sm:text-base focus:outline-none focus:border-[#18a692] focus:ring-1 focus:ring-[#18a692] transition-colors shadow-2xs"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full py-4 px-8 rounded-xl bg-[#0a2b4e] hover:bg-[#18a692] text-white font-bold text-base shadow-md shadow-[#0a2b4e]/20 hover:shadow-[#18a692]/25 transition-all hover:-translate-y-0.5 flex items-center justify-center gap-2"
            >
              <span id="btn-text">Submit Technical Inquiry</span>
              <svg id="btn-arrow" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <!-- Success message -->
            <div id="form-feedback" class="hidden text-center p-3.5 rounded-xl text-sm font-semibold bg-emerald-50 border border-emerald-300 text-emerald-800">
              Thank you. Mr. Dave will review your inquiry parameters and respond within 24 hours.
            </div>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const btnText = document.getElementById('btn-text');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (btnText) btnText.textContent = 'Submitting...';

    const formData = new FormData(form);
    const accessKey = formData.get('access_key');

    // If a real Web3Forms key has been entered, send live to their email API
    if (accessKey && accessKey !== 'YOUR_ACCESS_KEY_HERE') {
      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });
        const result = await response.json();
        if (result.success) {
          if (feedback) {
            feedback.textContent = 'Thank you. Mr. Dave has received your inquiry and will respond within 24 hours.';
            feedback.classList.remove('hidden');
          }
          if (btnText) btnText.textContent = 'Inquiry Sent ✓';
          form.reset();
        } else {
          alert('Submission error: ' + (result.message || 'Please reach out directly via phone or WhatsApp.'));
          if (btnText) btnText.textContent = 'Submit Technical Inquiry';
        }
      } catch (err) {
        alert('Network error. Please contact directly via email: pinkaldave13@gmail.com');
        if (btnText) btnText.textContent = 'Submit Technical Inquiry';
      }
    } else {
      // Local development simulation mode (when no API key has been added yet)
      setTimeout(() => {
        if (feedback) {
          feedback.textContent = 'Thank you. (Demo Mode: Form submission simulated. Connect your free Web3Forms key to receive live emails).';
          feedback.classList.remove('hidden');
        }
        if (btnText) btnText.textContent = 'Inquiry Submitted ✓';
        form.reset();
      }, 500);
    }
  });
</script>
