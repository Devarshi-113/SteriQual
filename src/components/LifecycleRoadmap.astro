---
import { siteData } from '../data/siteData';
---

<section id="lifecycle" class="py-28 bg-slate-50/50 border-t border-slate-200/80 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Ample Whitespace -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="text-xs font-mono uppercase tracking-wider text-slate-500 font-semibold">End-to-End Delivery Framework</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2 tracking-tight">
        The Pharmaceutical Facility Lifecycle
      </h2>
      <p class="text-base text-slate-500 mt-3 leading-relaxed">
        From brownfield renovation to greenfield commissioning, our structured 5-phase delivery aligns architects, equipment vendors, and regulatory defense at every milestone.
      </p>
    </div>

    <!-- 5-Phase Lifecycle Pipeline (Clean, Uncluttered) -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-5 relative">
      {siteData.lifecyclePhases.map((phase) => (
        <div class="flex flex-col justify-between p-6 rounded-2xl bg-white border border-slate-200/90 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.03)] hover:border-slate-300 hover:shadow-lg transition-all hover:-translate-y-0.5 group relative">
          
          <!-- Phase Number & Duration -->
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
                {phase.step}
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200/80 font-medium">
                {phase.duration}
              </span>
            </div>

            <!-- Phase Name -->
            <h3 class="text-base font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors">
              {phase.name}
            </h3>

            <!-- Focus area -->
            <p class="text-xs text-slate-500 leading-relaxed mb-4">
              {phase.focus}
            </p>
          </div>

          <!-- Concrete Phase Deliverable -->
          <div class="pt-4 border-t border-slate-100 mt-2">
            <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold block mb-1">Key Deliverable</span>
            <div class="text-[11px] font-semibold text-emerald-700 leading-snug">
              {phase.deliverable}
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Assurance Callout below Pipeline -->
    <div class="mt-14 p-6 sm:p-7 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-slate-600">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-900 font-bold shrink-0">
          ✓
        </div>
        <div>
          <span class="text-slate-900 font-semibold text-sm">Risk-Based Commissioning & Qualification (ASTM E2500)</span>
          <p class="text-slate-500 text-xs mt-0.5 leading-relaxed">Streamlining qualification timelines by replacing redundant testing with risk-assessed verification.</p>
        </div>
      </div>

      <a
        href="#contact"
        class="shrink-0 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold transition-colors"
      >
        Assess Project Timeline
      </a>
    </div>

  </div>
</section>
