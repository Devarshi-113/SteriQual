---
import { siteData } from '../data/siteData';
---

<section id="methodology" class="py-24 bg-slate-950 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="text-xs font-mono uppercase tracking-wider text-brand-400 font-semibold">Structured Delivery</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 tracking-tight">
        The Four-Phase Advisory Lifecycle
      </h2>
      <p class="text-base text-slate-400 mt-3">
        Our proprietary engagement framework minimizes project delays, eliminates audit findings, and keeps capital expenditures strictly aligned with regulatory expectations.
      </p>
    </div>

    <!-- Timeline / Grid Steps -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {siteData.methodology.map(step => (
        <div class="flex flex-col p-7 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-brand-500/50 transition-all hover:-translate-y-1 group">
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-mono font-extrabold text-slate-700 group-hover:text-brand-400 transition-colors">
              {step.step}
            </span>
            <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-brand-400 text-xs font-mono font-bold border border-slate-700">
              ✓
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-white mb-3 group-hover:text-brand-300 transition-colors">
            {step.title}
          </h3>

          <p class="text-xs text-slate-400 leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
