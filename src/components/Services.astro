---
import { siteData } from '../data/siteData';
---

<section id="services" class="py-14 md:py-16 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading with Executive Presentation & Accordion Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div class="max-w-3xl">
        <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-[#18a692] font-bold">
          Core Service Areas
        </span>
        <h2 
          class="text-3xl sm:text-4xl lg:text-5xl font-serif italic instrument-italic premium-italic text-[#0a2b4e] mt-1 tracking-tight"
          style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
        >
          Specialist Quality &amp; Compliance Advisory
        </h2>
        <p class="text-base sm:text-lg text-slate-700 mt-2 leading-relaxed font-sans">
          Focused services bridging quality systems, compliance and sterility assurance with global regulatory authority expectations. Click any service heading below to explore technical scope, methods, and work products.
        </p>
      </div>

      <!-- Action Controls: Expand/Collapse All + Inquiry Link -->
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <button
          id="toggle-all-services-btn"
          type="button"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-sans font-semibold text-[#0a2b4e] hover:text-[#18a692] px-3.5 py-2 rounded-xl bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] hover:from-[#e4f3f0] hover:to-[#d8eee9] transition-all shadow-2xs cursor-pointer select-none"
        >
          <span id="toggle-all-text">Expand All Services</span>
          <svg id="toggle-all-icon" class="w-3.5 h-3.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <a
          href="#contact"
          class="inline-flex items-center text-xs sm:text-sm font-bold text-[#0a2b4e] hover:text-[#18a692] px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors group"
        >
          <span>Discuss Scope</span>
          <svg class="ml-1 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- 11 Interactive Dropdown Service Cards (Border-less Gradients) -->
    <div class="space-y-4 sm:space-y-5">
      {siteData.servicePillars.map((pillar, idx) => (
        <details 
          class="service-accordion group rounded-3xl bg-gradient-to-br from-white via-[#fbfdfd] to-[#edf7f5]/40 border-0 shadow-[0_6px_25px_-6px_rgba(10,43,78,0.04)] hover:shadow-[0_12px_36px_-6px_rgba(24,166,146,0.12)] transition-all duration-300 overflow-hidden"
          open={idx === 0}
        >
          <!-- Clickable Header / Dropdown Trigger -->
          <summary class="list-none cursor-pointer p-5 sm:p-7 select-none transition-colors hover:bg-slate-50/50 flex flex-col md:flex-row md:items-center justify-between gap-4">
            
            <div class="flex items-start sm:items-center gap-3.5 sm:gap-4 flex-1">
              <!-- Service Number Badge -->
              <span class="text-xs sm:text-sm font-sans font-bold text-white bg-[#0a2b4e] group-hover:bg-[#128777] transition-colors px-3 py-1.5 rounded-xl shadow-2xs shrink-0 mt-0.5 sm:mt-0">
                {pillar.number}
              </span>

              <!-- Title, Category Badge & Subtitle -->
              <div class="space-y-1 flex-1">
                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
                  <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-[#0a2b4e] group-hover:text-[#128777] transition-colors tracking-tight">
                    {pillar.name}
                  </h3>
                  <span class="text-[11px] sm:text-xs font-sans text-[#18a692] font-bold tracking-wide uppercase bg-gradient-to-r from-[#f0faf8] to-[#e4f3f0] px-2.5 py-0.5 rounded-full border-0 shadow-2xs">
                    {pillar.badge}
                  </span>
                </div>

                <div 
                  class="text-xs sm:text-sm font-serif italic instrument-italic premium-italic text-[#18a692] font-semibold"
                  style="font-family: 'Instrument Serif', Georgia, Cambria, 'Times New Roman', serif; font-style: italic;"
                >
                  {pillar.headline}
                </div>
              </div>
            </div>

            <!-- Interactive Dropdown Status Indicator -->
            <div class="flex items-center gap-2.5 self-end md:self-center shrink-0 pt-1 md:pt-0">
              <span class="text-xs font-sans font-semibold text-slate-500 group-open:hidden hidden sm:inline">
                View Scope &amp; Deliverables
              </span>
              <span class="text-xs font-sans font-semibold text-[#18a692] group-open:inline hidden">
                Hide Details
              </span>
              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#f0faf8] to-[#e4f3f0] flex items-center justify-center text-[#0a2b4e] group-hover:bg-[#0a2b4e] group-hover:text-white transition-all shadow-2xs">
                <svg class="w-4 h-4 transform transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>

          </summary>

          <!-- Expanded Dropdown Content -->
          <div class="px-5 pb-7 sm:px-8 sm:pb-8 pt-2 border-t border-slate-100/90">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-3">
              
              <!-- Left Overview & Direct Action (4 cols) -->
              <div class="lg:col-span-4 space-y-4">
                <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans">
                  {pillar.description}
                </p>

                <div>
                  <a
                    href="#contact"
                    class="inline-flex items-center text-sm font-bold text-[#0a2b4e] hover:text-[#18a692] transition-colors gap-1.5 group/link"
                  >
                    <span>Inquire on this advisory scope</span>
                    <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </div>

              <!-- Right Scope & Work Products (8 cols) -->
              <div class="lg:col-span-8 bg-gradient-to-br from-[#f0faf8] via-[#e6f5f2] to-[#daf1ed]/60 rounded-2xl p-6 sm:p-7 border-0 shadow-2xs space-y-5">
                
                <!-- Technical Scope & Focus Areas with highlighted keywords for retention -->
                <div class="space-y-2.5">
                  <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-[#0a2b4e] font-bold block">
                    Technical Scope &amp; Focus Areas
                  </span>
                  
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm text-slate-800">
                    {pillar.points.map(pt => {
                      const colonIdx = pt.indexOf(':');
                      const hasColon = colonIdx !== -1;
                      const title = hasColon ? pt.substring(0, colonIdx) : null;
                      const desc = hasColon ? pt.substring(colonIdx + 1) : pt;

                      return (
                        <div class="flex items-start gap-2 leading-relaxed font-sans">
                          <span class="text-[#18a692] font-bold mt-1 text-sm leading-none shrink-0">•</span>
                          <span>
                            {hasColon ? (
                              <>
                                <strong class="font-semibold text-[#0a2b4e]">{title}:</strong>
                                <span class="text-slate-700">{desc}</span>
                              </>
                            ) : (
                              <span class="text-slate-700">{pt}</span>
                            )}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </div>

                <!-- Concrete Work Products & Deliverables -->
                <div class="pt-4 border-t border-[#b5e8df]/70">
                  <span class="text-xs sm:text-sm font-sans uppercase tracking-wider text-slate-600 font-bold block mb-2">
                    Concrete Deliverables &amp; Work Products
                  </span>
                  <div class="flex flex-wrap gap-2">
                    {pillar.deliverables.map(deliv => (
                      <span class="text-xs sm:text-sm font-sans font-medium px-3.5 py-1.5 rounded-xl bg-white/95 border-0 text-[#0a2b4e] shadow-2xs">
                        {deliv}
                      </span>
                    ))}
                  </div>
                </div>

              </div>

            </div>
          </div>

        </details>
      ))}
    </div>

  </div>
</section>

<!-- Lightweight Client-Side Accordion Control Script -->
<script>
  const toggleBtn = document.getElementById('toggle-all-services-btn');
  const toggleText = document.getElementById('toggle-all-text');
  const toggleIcon = document.getElementById('toggle-all-icon');
  const accordions = document.querySelectorAll<HTMLDetailsElement>('.service-accordion');

  toggleBtn?.addEventListener('click', () => {
    const anyClosed = Array.from(accordions).some(acc => !acc.open);
    
    accordions.forEach(acc => {
      acc.open = anyClosed;
    });

    if (toggleText) {
      toggleText.textContent = anyClosed ? 'Collapse All Services' : 'Expand All Services';
    }
    if (toggleIcon) {
      toggleIcon.classList.toggle('rotate-180', anyClosed);
    }
  });

  // Track manual accordion toggles to update the toggle-all button state
  accordions.forEach(acc => {
    acc.addEventListener('toggle', () => {
      const anyClosed = Array.from(accordions).some(a => !a.open);
      if (toggleText) {
        toggleText.textContent = anyClosed ? 'Expand All Services' : 'Collapse All Services';
      }
      if (toggleIcon) {
        toggleIcon.classList.toggle('rotate-180', !anyClosed);
      }
    });
  });
</script>
